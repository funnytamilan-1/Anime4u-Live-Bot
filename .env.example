# Telegram Bot & MTProto Credentials
BOT_TOKEN=
API_ID=
API_HASH=
TELEGRAM_SESSION_STRING=

# Service Mode: 'render' (bot UI only), 'worker' (MTProto worker only), or 'all' (both in one container)
SERVICE_MODE=all

# Backblaze B2 Storage Configuration
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_PUBLIC_BASE_URL=

# Database & System Configuration
DATABASE_PATH=./storage.db
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Security & Admin Access (Comma-separated Telegram user IDs)
ADMIN_IDS=

# Local Storage & Worker Limits
TEMP_DIR=./downloads
MAX_FILE_SIZE_BYTES=4294967296
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_FFMPEG=1
PORT=3000
PAGE_SIZE=10
